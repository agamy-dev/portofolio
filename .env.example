# Required: Claude API key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: model and effort
# ANTHROPIC_MODEL=claude-opus-5     # e.g. claude-sonnet-5 for lower cost
# CHAT_EFFORT=low                   # low | medium | high

# Optional: real calendar bookings via Cal.com (a demo calendar is used when unset)
# CALCOM_API_KEY=cal_live_...
# CALCOM_EVENT_TYPE_ID=123456       # the event type for discovery calls

# Optional: email lead and booking notifications via Resend (printed to the server log when unset)
# RESEND_API_KEY=re_...
# OWNER_EMAIL=you@example.com
# NOTIFY_FROM_EMAIL="Portfolio Agent <agent@yourdomain.com>"

# Optional: websites allowed to call /api/chat from the browser (comma-separated, or *)
# ALLOWED_ORIGINS=https://your-site.com,https://client-site.com

# Optional: where leads are saved locally
# LEADS_FILE=.data/leads.json
